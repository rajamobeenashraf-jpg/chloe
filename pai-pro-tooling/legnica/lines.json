    "captions": [
      {
        "start": 1.5,
        "end": 4.3,
        "text": "Henry died here. His army was broken."
      },
      {
        "start": 5.0,
        "end": 7.8,
        "text": "But this castle — the one behind me — never fell."
      },
      {
        "start": 8.2,
